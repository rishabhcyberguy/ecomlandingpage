{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "POLINA: Start development server",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "POLINA: Type check",
      "type": "shell",
      "command": "pnpm",
      "args": ["check"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "POLINA: Run tests",
      "type": "shell",
      "command": "pnpm",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "POLINA: Production build",
      "type": "shell",
      "command": "pnpm",
      "args": ["build"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
