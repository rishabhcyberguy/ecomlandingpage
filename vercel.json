{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:vercel",
  "functions": {
    "index.ts": {
      "includeFiles": "dist/public/index.html"
    }
  },
  "headers": [
    {
      "source": "/manus-routes.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/polina-mark.svg",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/images/polina-hero.jpg",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
